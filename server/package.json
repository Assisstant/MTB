{
  "name": "therapy-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local TypeScript API for Rasporedi + S-Dnevnik (PostgreSQL backed)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "import": "tsx scripts/import-json.ts",
    "export": "tsx scripts/export-json.ts",
    "rollover": "tsx scripts/rollover-year.ts",
    "sync": "tsx scripts/sync-peer.ts",
    "test": "tsx --test test/*.test.ts",
    "test:roster": "tsx test/roster-write.e2e.ts",
    "test:diary": "tsx test/diary-write.e2e.ts",
    "test:week": "tsx test/diary-schedule.e2e.ts",
    "test:records": "tsx test/records.e2e.ts",
    "test:state-atomicity": "tsx test/state-atomicity.e2e.ts",
    "test:recovery": "node test/rslots-recovery.browser.mjs",
    "test:hydrate": "node test/hydrate.browser.mjs",
    "check:names": "tsx scripts/check-names.ts",
    "check:lists": "tsx scripts/check-lists.ts",
    "import:roster": "tsx scripts/import-roster.ts",
    "import:teaching": "tsx scripts/import-teaching.ts",
    "copy:teaching": "tsx scripts/copy-teaching-year.ts",
    "test:teaching-edit": "tsx test/teaching-edit.e2e.ts",
    "test:uredi": "node test/nastava-uredi.browser.mjs",
    "test:podatoci": "node test/podatoci.browser.mjs",
    "test:annual-roster": "tsx test/annual-roster.e2e.ts",
    "test:purge": "tsx test/roster-purge.e2e.ts",
    "test:fusion": "tsx test/fusion-schedule.e2e.ts",
    "test:fusion-ui": "node test/fusion.browser.mjs",
    "test:navigation": "node test/app-navigation.browser.mjs",
    "test:therapist-view": "node test/per-therapist-view.browser.mjs",
    "test:sdnevnik-compat": "node test/sdnevnik-compat.browser.mjs",
    "test:teaching": "tsx test/teaching.e2e.ts",
    "test:crossing": "tsx --test test/crossing.test.ts test/teaching.test.ts",
    "test:projection": "tsx test/state-projection.e2e.ts",
    "test:nastava": "node test/nastava.browser.mjs",
    "test:evidence": "tsx test/evidence.e2e.ts",
    "test:evidence-ui": "node test/evidence.browser.mjs",
    "test:categories": "tsx test/categories.e2e.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
