{
  "name": "therapy-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local TypeScript API for Rasporedi + S-Dnevnik (PostgreSQL backed)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "import": "tsx scripts/import-json.ts",
    "export": "tsx scripts/export-json.ts",
    "rollover": "tsx scripts/rollover-year.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
