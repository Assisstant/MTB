# Example names only. Copy selected lines into the ignored server/.env and
# replace every placeholder locally. Never commit a real URL, password or key.

DATABASE_URL=postgresql://APP_READONLY_USER:APP_PASSWORD@localhost:5432/therapy_mirror
SYNC_NAME=home

# Cloud/Render export (off until the reviewed rollout):
MTB_MIRROR_EXPORT=0
MTB_MIRROR_EXPORT_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Local mirror application and pull process (also off until one PC is approved):
MTB_MIRROR_MODE=off
MTB_MIRROR_SOURCE_URL=https://YOUR_MTB_RENDER_SERVICE.onrender.com
MTB_MIRROR_SOURCE_ID=cloud-test
MTB_MIRROR_SOURCE_LABEL=Supabase
MTB_MIRROR_PULL_KEY=REPLACE_WITH_THE_REVOKABLE_EXPORT_SECRET
MTB_MIRROR_TARGET_DATABASE=therapy_mirror
MTB_MIRROR_TARGET_DATABASE_URL=postgresql://SYNC_WRITER_USER:SYNC_PASSWORD@localhost:5432/therapy_mirror
MTB_MIRROR_TIMEOUT_SECONDS=60
